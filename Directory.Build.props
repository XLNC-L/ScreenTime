<Project>

  <!--
    生成并校验 packages.lock.json：依赖版本真正锁定，换机器/换时间还原都一致。
    锁文件必须提交进版本库，否则等于没锁。
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    版本号只在这里写一份，三个 csproj 不再各写一遍（三处同步容易漏）。
    CI / 发布脚本仍可用 -p:Version=x.y.z 覆盖。
  -->
  <PropertyGroup>
    <Version>1.4.5</Version>
  </PropertyGroup>

</Project>
