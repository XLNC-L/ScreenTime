<Page
    x:Class="ScreenTime.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}" Text="应用" />

        <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="搜索应用"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="FilterBox"
                Grid.Column="1"
                Header="分类筛选"
                HorizontalAlignment="Stretch"
                SelectionChanged="FilterBox_SelectionChanged" />
            <Button
                x:Name="ImportBtn"
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Click="ImportBtn_Click"
                ToolTipService.ToolTip="扫描开始菜单，把已安装但还没用过的应用加入列表（时长为 0，方便提前分类）">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE8B5;" />
                    <TextBlock Text="导入已安装应用" />
                </StackPanel>
            </Button>
            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="16">
                <CheckBox
                    x:Name="UsedOnlyBox"
                    VerticalAlignment="Center"
                    Checked="UsedOnlyBox_Toggled"
                    Content="仅显示有使用记录"
                    ToolTipService.ToolTip="隐藏从未运行过的应用（导入后时长为 0 的条目）"
                    Unchecked="UsedOnlyBox_Toggled" />
                <ToggleSwitch
                    x:Name="ShowHiddenSwitch"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent="显示已忽略"
                    OnContent="显示已忽略"
                    Toggled="ShowHiddenSwitch_Toggled"
                    ToolTipService.ToolTip="显示被标记忽略或已合并到其他条目的应用" />
            </StackPanel>
        </Grid>

        <!-- 两列 -->
        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 应用列表 -->
            <Border
                Grid.Column="0"
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView x:Name="AppListBox" SelectionChanged="AppListBox_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Source="{Binding Icon}" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Sub}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 应用详情 -->
            <Border
                Grid.Column="1"
                Padding="16"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="AppNameText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="AppProcText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="未选择应用" />

                    <ComboBox
                        x:Name="CategoryBox"
                        Header="分类"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="CategoryBox_SelectionChanged" />

                    <ComboBox
                        x:Name="PurposeBox"
                        Header="默认用途"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="PurposeBox_SelectionChanged" />

                    <ToggleSwitch
                        x:Name="IgnoreSwitch"
                        Header="忽略此应用（不计入统计）"
                        OnContent="已忽略"
                        OffContent="正常统计"
                        Toggled="IgnoreSwitch_Toggled" />

                    <ComboBox
                        x:Name="MergeBox"
                        Header="合并到"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name" />
                    <Button HorizontalAlignment="Stretch" Click="MergeBtn_Click">
                        <TextBlock Text="合并" />
                    </Button>

                    <!-- 浏览器：各网页时长（近 30 天） -->
                    <StackPanel x:Name="SitePanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="各网页时长（近 30 天）" />
                        <ListView
                            x:Name="SiteListBox"
                            MaxHeight="260"
                            IsItemClickEnabled="True"
                            ItemClick="SiteListBox_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTipService.ToolTip="{Binding Url}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                Text="{Binding Site}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{Binding Site}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Sub}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{Binding Sub}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Duration}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
