<Page
    x:Class="ScreenTime.Pages.WebPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="网页" />
                <AutoSuggestBox
                    x:Name="TimelineSearchBox"
                    Grid.Column="1"
                    Width="220"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索标题或网址"
                    QueryIcon="Find"
                    TextChanged="TimelineSearchBox_TextChanged"
                    QuerySubmitted="TimelineSearchBox_QuerySubmitted" />
                <ComboBox
                    x:Name="BrowserBox"
                    Grid.Column="2"
                    MinWidth="150"
                    VerticalAlignment="Center"
                    DisplayMemberPath="Display"
                    SelectionChanged="BrowserBox_SelectionChanged"
                    ToolTipService.ToolTip="按来源浏览器筛选；每行行首的小图标也表示来源" />
                <ComboBox
                    x:Name="RangeBox"
                    Grid.Column="3"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    SelectionChanged="RangeBox_SelectionChanged">
                    <ComboBoxItem Tag="7" Content="近 7 天" />
                    <ComboBoxItem Tag="30" Content="近 30 天" />
                    <ComboBoxItem Tag="90" Content="近 90 天" />
                </ComboBox>
            </Grid>

            <TextBlock
                x:Name="SummaryText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />

            <!-- 加载失败时的页内提示，不靠全局兜底留白 -->
            <InfoBar
                x:Name="ErrorBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="加载失败">
                <InfoBar.ActionButton>
                    <Button Click="RetryBtn_Click" Content="重试" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 网页时间线：按选定日期范围显示浏览器前台片段，最新记录在前。 -->
            <Border
                x:Name="TimelineCard"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="网页时间线" />
                    <TextBlock
                        x:Name="TimelineEmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="暂无网页时间线记录。"
                        Visibility="Collapsed" />
                    <ItemsControl x:Name="TimelineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,6" MinHeight="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Text="{Binding DateLabel}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding TimeLabel}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Border
                                            Width="2"
                                            Height="52"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            HorizontalAlignment="Center" />
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Fill="{Binding DotBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="8,0,12,0" VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Sub}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="3"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Duration}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
