<Page
    x:Class="ScreenTime.Pages.WebPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="网页" />
                <ComboBox
                    x:Name="BrowserBox"
                    Grid.Column="1"
                    MinWidth="150"
                    VerticalAlignment="Center"
                    DisplayMemberPath="Display"
                    SelectionChanged="BrowserBox_SelectionChanged"
                    ToolTipService.ToolTip="按来源浏览器筛选；每行行首的小图标也表示来源" />
                <ComboBox
                    x:Name="RangeBox"
                    Grid.Column="2"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    SelectionChanged="RangeBox_SelectionChanged">
                    <ComboBoxItem Tag="7" Content="近 7 天" />
                    <ComboBoxItem Tag="30" Content="近 30 天" />
                    <ComboBoxItem Tag="90" Content="近 90 天" />
                </ComboBox>
            </Grid>

            <TextBlock
                x:Name="SummaryText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />

            <!-- 加载失败时的页内提示，不靠全局兜底留白 -->
            <InfoBar
                x:Name="ErrorBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="加载失败">
                <InfoBar.ActionButton>
                    <Button Click="RetryBtn_Click" Content="重试" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="EmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="暂无网页记录。浏览器页面地址来自实时读取与本地历史库回填，历史库通常只有最近几天数据。"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,10" Spacing="6">
                                    <!-- 分组头：域名 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding Host}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Duration}" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <!-- 页面行 -->
                                    <ItemsControl ItemsSource="{Binding Pages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Padding="8,6"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Tapped="PageRow_Tapped"
                                                    ToolTipService.ToolTip="{Binding Url}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 来源浏览器：小图标代替文字 -->
                                                    <Image
                                                        Grid.Column="0"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,3,8,0"
                                                        VerticalAlignment="Top"
                                                        Source="{Binding Icon}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Sub}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Duration}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
