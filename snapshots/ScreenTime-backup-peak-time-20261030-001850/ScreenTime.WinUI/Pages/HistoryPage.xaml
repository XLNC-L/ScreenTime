<Page
    x:Class="ScreenTime.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ScreenTime.UI">

    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="24">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="历史" />

            <!-- 加载失败时的页内提示，不靠全局兜底留白 -->
            <InfoBar
                x:Name="ErrorBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="加载失败">
                <InfoBar.ActionButton>
                    <Button Click="RetryBtn_Click" Content="重试" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 控制条 -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CalendarDatePicker x:Name="FromPicker" Grid.Column="0" Header="开始日期" />
                    <CalendarDatePicker x:Name="ToPicker" Grid.Column="1" Header="结束日期" />
                    <Button
                        x:Name="QueryBtn"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Click="QueryBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontSize="12" Glyph="&#xE721;" />
                            <TextBlock Margin="8,0,0,0" Text="查询" />
                        </StackPanel>
                    </Button>
                    <AutoSuggestBox
                        x:Name="AppSearchBox"
                        Grid.Column="3"
                        Width="240"
                        PlaceholderText="搜索应用或进程"
                        TextChanged="AppSearchBox_TextChanged" />
                </Grid>
            </Border>

            <!-- 概览 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总时长" />
                        <TextBlock x:Name="TotalText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="日均" />
                        <TextBlock x:Name="AvgText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="天数" />
                        <TextBlock x:Name="DaysText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="环比" />
                        <TextBlock x:Name="DeltaText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 左列内容决定高度，右列应用排行绑定左列高度，保证齐平 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左列：分类占比 + 用途分布 -->
                <StackPanel x:Name="LeftCol" Grid.Column="0" VerticalAlignment="Top" Spacing="16">

                <!-- 分类占比 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="分类占比" />
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:DonutChart x:Name="Donut" Width="140" Height="140" Grid.Column="0" />
                            <ItemsControl x:Name="Legend" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" Tapped="CategoryLegend_Tapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="12" Height="12" Grid.Column="0" Fill="{Binding Brush}" />
                                            <TextBlock Margin="8,0,0,0" Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Percent}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 用途分布 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="用途分布" />
                            <Button x:Name="NormalizeBtn" HorizontalAlignment="Right" Padding="10,4" Click="NormalizeBtn_Click" Content="未判定一键归类" />
                        </Grid>
                        <Grid x:Name="PurposeBar" Height="12" />
                        <ItemsControl x:Name="PurposeLegend">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="12" Height="12" Grid.Column="0" Fill="{Binding Brush}" />
                                        <TextBlock Margin="8,0,0,0" Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Percent}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                </StackPanel>

                <!-- 应用排行（高度与左列一致，内部滚动） -->
                <Border
                    x:Name="AppRankCard"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}" Text="应用排行" />
                        <!-- 用 ListView 而不是 ItemsControl+ScrollViewer：ItemsControl 无虚拟化，
                             几十个应用 × 每项 5 控件全部实例化，内存和布局都吃亏。ListView 自带虚拟化 + 滚动 -->
                        <ListView
                            x:Name="AppList"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            RightTapped="AppList_RightTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Source="{Binding Icon}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Duration}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Grid.Row="1" Margin="0,3,0,0" Maximum="100" Value="{Binding BarPercent}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                </Border>
            </Grid>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="每日时长" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                        <ItemsControl x:Name="Bars">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="40" Margin="0,0,8,0">
                                        <Grid.RowDefinitions><RowDefinition Height="184" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" VerticalAlignment="Bottom">
                                            <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Hours}" />
                                            <Rectangle Height="{Binding BarHeight}" RadiusX="4" RadiusY="4" Fill="{Binding Brush}" ToolTipService.ToolTip="{Binding Tip}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="最活跃时段" />
                        <Grid x:Name="HourHeat" Height="26" />
                        <Grid x:Name="HourTicks" Height="14" />
                        <TextBlock x:Name="ActiveHoursText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Top 应用" />
                        <ItemsControl x:Name="TopApps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Duration}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
